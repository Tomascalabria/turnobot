// LA fuente de verdad de la DB
// npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Planes disponibles ─────────────────────────────────────────────────────
enum Plan {
  FREE
  STARTER
  PRO
}

// ── Estado de un turno ─────────────────────────────────────────────────────
enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

// ── Profesional (usuario del panel web) ───────────────────────────────────
model Professional {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  phone           String?  // número WA del profesional
  whatsappPhone   String?  // número WA business configurado
  plan            Plan     @default(FREE)
  planExpiresAt   DateTime?

  // Google Calendar OAuth
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  googleCalendarId   String?

  // MercadoPago OAuth
  mpAccessToken   String?
  mpRefreshToken  String?
  mpUserId        String?

  services        Service[]
  appointments    Appointment[]
  botConfig       BotConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Servicio que ofrece el profesional ────────────────────────────────────
model Service {
  id             String   @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  durationMin    Int      // duración en minutos
  price          Decimal  @db.Decimal(10, 2)
  depositPct     Int      @default(30) // porcentaje de seña (0 = sin seña)
  active         Boolean  @default(true)

  appointments   Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Turno ──────────────────────────────────────────────────────────────────
model Appointment {
  id             String   @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  serviceId      String
  service        Service  @relation(fields: [serviceId], references: [id])

  patientName    String
  patientPhone   String   // número WA del paciente
  startAt        DateTime
  endAt          DateTime
  status         AppointmentStatus @default(PENDING)

  // Pago
  totalAmount    Decimal  @db.Decimal(10, 2)
  depositAmount  Decimal  @db.Decimal(10, 2) @default(0)
  depositPaid    Boolean  @default(false)
  mpPaymentId    String?
  mpPreferenceId String?

  // Google Calendar
  gcEventId      String?

  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Configuración del bot por profesional ─────────────────────────────────
model BotConfig {
  id             String   @id @default(cuid())
  professionalId String   @unique
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  greetingMsg    String   @default("¡Hola! Soy el asistente de {profesional}. ¿En qué te puedo ayudar?")
  awayMsg        String   @default("En este momento no estoy disponible. Te responderé a la brevedad.")
  confirmMsg     String   @default("Tu turno fue confirmado para el {fecha} a las {hora}. ¡Te esperamos!")
  reminderMsg    String   @default("Te recordamos tu turno para mañana {fecha} a las {hora}.")

  workdayStart   String   @default("09:00")
  workdayEnd     String   @default("18:00")
  workdays       Int[]    @default([1,2,3,4,5]) // 0=Dom..6=Sáb
  slotGapMin     Int      @default(0)            // minutos entre turnos

  updatedAt DateTime @updatedAt
}

// ── Conversación / sesión del bot ──────────────────────────────────────────
model Conversation {
  id             String   @id @default(cuid())
  patientPhone   String   @unique
  professionalId String?

  state          String   @default("IDLE") // estado de la FSM
  context        Json     @default("{}")   // datos intermedios

  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
