# ── Base de datos ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/turnobot"

# ── WhatsApp (Meta Cloud API) ──────────────────────────────
WA_PHONE_ID="<phone-number-id>"
WA_TOKEN="<permanent-system-user-token>"
WA_VERIFY_TOKEN="<token-aleatorio-que-vos-elegis>"

# ── Google Calendar OAuth ──────────────────────────────────
GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<client-secret>"
GOOGLE_REDIRECT_URI="https://<tu-ngrok>.ngrok-free.app/api/calendar/callback"

# ── MercadoPago ────────────────────────────────────────────
MP_CLIENT_ID="<app-id>"
MP_CLIENT_SECRET="<client-secret>"
MP_REDIRECT_URI="https://<tu-ngrok>.ngrok-free.app/api/mercadopago/callback"

# ── Redis ──────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── NextAuth (apps/web) ────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<openssl-rand-base64-32>"

# ── Bot URL (para que Next.js llame al Express) ────────────
BOT_API_URL="http://localhost:3001"
BOT_API_SECRET="<shared-secret-entre-next-y-express>"
